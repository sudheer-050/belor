{
  "name": "belor",
  "productName": "Belor",
  "version": "0.7.10",
  "description": "A Windows terminal for your shells and AI coding assistants: color-coded tabs, Claude Code and Codex awareness, popups and sounds, admin tabs in the same window",
  "author": "Sudheer Kumar Gandiboyana",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron tools/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.belor.app",
    "productName": "Belor",
    "copyright": "Copyright Â© 2026 Sudheer Kumar Gandiboyana",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "shell/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "shell/**",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Belor",
      "deleteAppDataOnUninstall": false
    }
  },
  "homepage": "https://github.com/sudheer-050/belor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudheer-050/belor.git"
  },
  "bugs": {
    "url": "https://github.com/sudheer-050/belor/issues"
  },
  "keywords": [
    "terminal",
    "windows",
    "electron",
    "xterm",
    "powershell",
    "claude-code",
    "codex",
    "ai-assistant",
    "developer-tools"
  ]
}
